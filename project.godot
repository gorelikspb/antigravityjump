; Engine configuration file.
; Anti-Gravity Jump — Godot 4.x project.

config_version=5

[application]

config/name="Anti-Gravity Jump"
config/description="2D platformer with 4-way gravity flipping (prototype)."
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

InputBootstrap="*res://src/core/input_bootstrap.gd"
SoundManager="*res://src/core/sound_manager.gd"
SaveManager="*res://src/core/save_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="triggers"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.11, 1)
